# h3-prompt 환경 변수 (컨테이너 없이 CLI나 `uv run server.py`로 쓸 때).
# 모두 선택이고, 적지 않으면 기본값을 쓴다. 프로그램이 이 파일을 읽지는 않는다: 셸에서 환경 변수로 주거나
# `uv run --env-file .env server.py`처럼 넘긴다. Docker Compose용은 deploy/.env.example을 본다.

# LLM 서버 (OpenAI 호환 /v1)
H3_BASE_URL=http://127.0.0.1:8080/v1
# 요청에 넣는 모델 이름. llama.cpp는 무시하고, 여러 모델을 내는 서버는 이 이름으로 고른다
H3_MODEL=gemma4
# 서버가 키를 요구할 때만
H3_API_KEY=

# 웹 서버
H3_HOST=127.0.0.1
H3_PORT=8000
# 동시에 돌릴 생성 수. 로컬 LLM 하나를 나눠 쓰면 1로 둔다 (나머지 요청은 줄을 선다)
H3_CONCURRENCY=1
# 줄을 설 수 있는 요청 수. 넘으면 503으로 거절한다
H3_MAX_WAITING=8
# 이미지 한 장의 크기 한도(MB)와 요청문 길이 한도(글자)
H3_MAX_UPLOAD_MB=10
H3_MAX_REQUEST_CHARS=2000
# LLM 호출 한 번의 제한 시간(초)
H3_LLM_TIMEOUT=300
# 이미지 읽기 캐시 폴더. 비워 두면 프로젝트의 .cache/look
H3_CACHE_DIR=
