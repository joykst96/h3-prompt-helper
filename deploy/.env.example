# Docker Compose용 설정. deploy/.env로 복사해서 쓴다 (deploy/.env는 저장소에 넣지 않는다).

# 필수. LLM 서버 주소 (OpenAI 호환 /v1). 컨테이너 안에서 닿는 주소여야 한다
#   LLM 서버가 이 컨테이너를 돌리는 PC에 있으면:  http://host.docker.internal:8080/v1
#   다른 서버에 있으면 그 서버의 주소:            http://llm.example.com:8080/v1
H3_BASE_URL=http://host.docker.internal:8080/v1

# 아래는 선택. 적지 않으면 이 값들이 기본이다
# LLM 서버에 보내는 모델 이름. llama.cpp는 무시하고, 여러 모델을 내는 서버는 이 이름으로 고른다
H3_MODEL=gemma4
# LLM 서버가 키를 요구할 때만
H3_API_KEY=
# 이 PC에서 여는 포트
H3_PORT=8000
# 동시에 돌릴 생성 수와 줄을 설 수 있는 요청 수
H3_CONCURRENCY=1
H3_MAX_WAITING=8
# 이미지 한 장의 크기 한도(MB)
H3_MAX_UPLOAD_MB=10
